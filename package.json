{
  "name": "leonwillow-work-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "turbo run prepare",
    "dev": "turbo run dev --filter=@platform/web --filter=@platform/server",
    "dev:desktop": "turbo run dev --filter=@platform/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.4"
  }
}
