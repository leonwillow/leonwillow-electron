{
	"name": "leonwillow-electron",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"better-auth": "1.7.5",
			"lucide-react": "^1.41.0",
			"next-themes": "0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types && tsc --noEmit -p tsconfig.json",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @leonwillow-electron/db --",
		"db:studio": "turbo run db:studio -F @leonwillow-electron/db --",
		"db:generate": "turbo run db:generate -F @leonwillow-electron/db --",
		"db:migrate": "turbo run db:migrate -F @leonwillow-electron/db --",
		"db:start": "turbo run db:start -F @leonwillow-electron/db --",
		"db:watch": "turbo run db:watch -F @leonwillow-electron/db --",
		"db:stop": "turbo run db:stop -F @leonwillow-electron/db --",
		"db:down": "turbo run db:down -F @leonwillow-electron/db --",
		"env:generate": "turbo run env:generate",
		"routes:generate": "turbo run routes:generate",
		"generate": "turbo run env:generate routes:generate",
		"postinstall": "bun run generate",
		"auth:init": "bun run --cwd apps/server auth:init",
		"auth:schema": "bun run --cwd packages/auth schema:generate",
		"check": "bun run verify",
		"fix": "biome check --write .",
		"verify": "bun run lint && bun run check-types && bun run test:ui && bun run test:architecture && bun run test:server && bun run build && bun run test:deploy",
		"verify:all": "bun run verify && bun run test:api",
		"test:server": "bun run --cwd apps/server test:unit",
		"test:deploy": "bun scripts/check-web-deployment.ts",
		"test:api": "bun run --cwd apps/server test",
		"test:architecture": "bun test scripts/architecture.test.ts",
		"lint": "biome check . && bun scripts/check-ui-styles.ts",
		"test:ui": "bun test scripts/check-ui-styles.test.ts packages/ui/test && bun run --cwd apps/web test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@leonwillow-electron/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.3.14",
	"dependencies": {
		"@neon/config": "^1.9.2",
		"@neon/env": "^1.6.3"
	}
}
