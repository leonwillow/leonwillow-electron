{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "env:generate"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types", "env:generate"]
		},
		"web#check-types": {
			"dependsOn": ["^check-types", "env:generate", "routes:generate"]
		},
		"web#build": {
			"dependsOn": ["^build", "env:generate", "routes:generate"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"env:generate": { "outputs": ["src/env.ts"] },
		"routes:generate": { "outputs": ["src/routeTree.gen.ts"] },
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false
		},
		"db:stop": {
			"cache": false
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false
		}
	},
	"globalEnv": [
		"AWS_ACCESS_KEY_ID",
		"AWS_ENDPOINT_URL_S3",
		"AWS_REGION",
		"AWS_SECRET_ACCESS_KEY",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"CORS_ORIGIN",
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"NODE_ENV",
		"PORT",
		"TRUSTED_PROXY_IPS",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"VITE_SERVER_URL",
		"_VARLOCK_ENV_KEY"
	],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
