# 远程 Docker 后端环境变量模板（复制为远程目录的 .env.server 并填入真实凭据，禁止提交秘钥到 Git）

NODE_ENV=production
PORT=3000

# 对外提供 API 的地址（供 Better Auth 生成回调与判断 Secure Cookie）
BETTER_AUTH_URL=http://100.100.1.3:3000

# 允许的浏览器前端来源（逗号分隔）；Electron 桌面端 aidesk://app 由服务端默认放行
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://100.100.1.1:3001

# 至少 32 位随机密钥（沿用既有密钥可保留历史登录会话）
BETTER_AUTH_SECRET=replace-with-at-least-32-char-secret

# 直连同机 1panel-network 中的既有 PostgreSQL 容器
DATABASE_URL=postgresql://leonwillow:replace-password@postgresql:5432/leonwillow
DATABASE_URL_UNPOOLED=postgresql://leonwillow:replace-password@postgresql:5432/leonwillow

# 远程 Compose 内部 Neo4j 与 RustFS（仅 aidesk-backend 内网访问）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-neo4j-password

RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=funds-originals
RUSTFS_ACCESS_KEY=aidesk-funds
RUSTFS_SECRET_KEY=replace-rustfs-secret-key

# 资金流水 AI 标准化配置（可选）
FUNDS_AI_BASE_URL=https://sub2api.lanwu114.top
FUNDS_AI_MODEL=gpt-6.1-sol
FUNDS_AI_API_KEY=
