{
	"name": "server",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun --bun tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:init": "bun src/init-admin.ts",
		"test:unit": "bun test test/health.test.ts test/auth-response.test.ts test/client-ip.test.ts test/lifecycle.test.ts",
		"test": "bun test --preload varlock/auto-load",
		"test:health": "bun test test/health.test.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@leonwillow-electron/auth": "workspace:*",
		"@leonwillow-electron/db": "workspace:*",
		"elysia": "^1.4.30",
		"varlock": "catalog:",
		"@leonwillow-electron/access": "workspace:*",
		"drizzle-orm": "catalog:"
	},
	"devDependencies": {
		"@elysiajs/eden": "^1.4.9",
		"@leonwillow-electron/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	},
	"exports": {
		"./app": {
			"types": "./src/app.ts"
		}
	}
}
