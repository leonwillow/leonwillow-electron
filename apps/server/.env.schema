# 文件意义：服务端启动环境的校验定义。
# 创建时间：2026-10-03（Git 首次收录）
# 修改时间：2026-10-04
# 版本作用：当前工作区的工具/启动配置。
# 被调用：Varlock、服务启动入口。
# 调用：部署或本地环境覆盖值。
# 功能：校验数据库地址、认证签名配置、端口和允许来源。
# 预期结果：配置不合法时在启动前失败。

# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Web 开发端口可同时允许多个明确来源，逗号分隔。
# @public @type=string(minLength=1)
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# @public @type=number
PORT=3000

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=http://localhost:3000

# @type=string(minLength=1)
DATABASE_URL=

# 仅 auth:init 使用，常规启动不读取此密码；不提供默认凭据。
# @required=false @sensitive @type=string
ADMIN_INITIAL_PASSWORD=

# 可读取 X-Real-IP 的直接代理地址，逗号分隔；默认不信任任何代理，不接受 CIDR。
# @public @required=false @type=string
TRUSTED_PROXY_IPS=

# 本地开发 Neo4j；生产环境必须覆盖凭据，连接失败不影响公共健康检查。
# @public @type=string(minLength=1)
NEO4J_URI=bolt://127.0.0.1:7687

# @public @type=string(minLength=1)
NEO4J_USER=neo4j

# @type=string(minLength=8)
NEO4J_PASSWORD=local-funds-dev

# AI 标准化调用兼容 Responses API 的服务；仅后台 worker 读取。
# @public @type=url
FUNDS_AI_BASE_URL=https://sub2api.lanwu114.top

# @public @type=string(minLength=1)
FUNDS_AI_MODEL=gpt-6.1-sol

# @required=false @sensitive @type=string
FUNDS_AI_API_KEY=

# 案件原件的 S3 兼容存储；开发环境对应 Compose RustFS。
# @public @type=url
RUSTFS_ENDPOINT=http://127.0.0.1:9000

# @public @type=string(minLength=3)
RUSTFS_BUCKET=funds-originals

# @type=string(minLength=1)
RUSTFS_ACCESS_KEY=local-funds

# @type=string(minLength=8)
RUSTFS_SECRET_KEY=local-funds-files-dev
